# Mobile (Expo) Environment Configuration - SERVERLESS/CLIENT-SIDE ONLY

# This app is now fully client-side/serverless - all data is stored locally

# Use mock API (set to "false" to disable, but there is no backend)
EXPO_PUBLIC_USE_MOCK_API="true"

# RevenueCat (get key from RevenueCat dashboard)
EXPO_PUBLIC_REVENUECAT_API_KEY="rcbp_your_key_here"

# Environment
EXPO_PUBLIC_ENV="development"
