# ═══════════════════════════════════════════
# FitQuest 2.0 — Environment Variables
# ═══════════════════════════════════════════
# Fully client-side serverless app. No backend required.
# All data stored locally on-device via SQLite.

# ── Core API (optional — offline-first by default) ──
# EXPO_PUBLIC_API_BASE_URL=https://api.fitquest.app
# EXPO_PUBLIC_BACKUP_API_BASE_URL=https://backup.fitquest.app
# EXPO_PUBLIC_AUTHORITY_API_KEY=your_authority_server_api_key_here

# Phase 25A: No client-side signing secrets.
# Device verification uses server-issued challenge-response protocol.

# ── App Config ──
EXPO_PUBLIC_ENV="development"
EXPO_PUBLIC_USE_MOCK_API="false"

# ── RevenueCat (Subscriptions) ──
EXPO_PUBLIC_REVENUECAT_API_KEY="rcbp_your_key_here"

# ── Sentry (Crash Reporting) ──
# EXPO_PUBLIC_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# ── Google OAuth ──
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=""
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=""
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=""
EXPO_PUBLIC_OAUTH_ANDROID_ONLY="true"

# ── AI Proxy (production — keys stay server-side) ──
# EXPO_PUBLIC_AI_PROXY_URL="https://fitquest-ai-proxy.YOUR_SUBDOMAIN.workers.dev"
# EXPO_PUBLIC_AI_PROXY_APP_KEY=""

# ── AI Providers (dev-mode fallback — only if proxy is NOT configured) ──
# EXPO_PUBLIC_GROQ_API_KEY=""
# EXPO_PUBLIC_GROK_API_KEY=""
# EXPO_PUBLIC_OPENROUTER_API_KEY=""

# ── PostHog (Analytics + Session Replay) ──
EXPO_PUBLIC_POSTHOG_API_KEY=""
EXPO_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"

# ── FitMind Reader Engine ──
# Options: native_pdf | web_pdfjs | web_epub | external
# EXPO_PUBLIC_FITMIND_READER_ENGINE=native_pdf

