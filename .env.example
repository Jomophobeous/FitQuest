# Mobile (Expo) Environment Configuration
# This is a fully client-side serverless application
# No backend server is required - all data is stored locally on the device

# This app uses local mock data - no backend configuration needed
EXPO_PUBLIC_USE_MOCK_API="true"

# RevenueCat (if using in-app purchases - optional)
EXPO_PUBLIC_REVENUECAT_API_KEY="rcbp_your_key_here"

# Environment
EXPO_PUBLIC_ENV="development"

