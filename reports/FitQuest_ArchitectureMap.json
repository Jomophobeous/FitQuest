  "dataFlows": {
    "appLaunch": {
      "sequence": [
        "1. _layout.tsx mounts provider hierarchy",
        "2. DatabaseContext: initializeDatabase() → schema creation → migrations → seeding",
        "3. AuthContext: restore session from SecureStore → biometric check",
        "4. ThemeContext: load preference from app_state",
        "5. LanguageContext: load language, preload exercise translations",
        "6. WriteAheadLogService: init WAL, check for unfinished replays",
        "7. SnapshotService: check snapshot schedule",
        "8. RecoveryService: check for corruption, repair if needed",
        "9. Route to appropriate screen (splash → onboarding/dashboard)"
      ]
    },
    "workoutGeneration": {
      "sequence": [
        "1. User taps 'Start Workout' on dashboard or fitquest",
        "2. useFitQuestWorkout hook → workoutGenerator.generateWorkout()",
        "3. Generator reads: user_profile, muscle_fatigue, available exercises, equipment",
        "4. Pipeline: fatigue filtering → goal targeting → muscle balancing → volume prescription → edge case guards",
        "5. Returns WorkoutSession with ordered exercises, prescribed sets/reps",
        "6. warmupCooldownGenerator adds warmup/cooldown exercises",
        "7. Session stored in workout_sessions + session_exercises tables"
      ]
    },
    "activeWorkout": {
      "sequence": [
        "1. Timer starts per exercise (timerService singleton)",
        "2. Audio cues play (audioService → expo-speech TTS)",
        "3. Sensor fusion polls at 10Hz (SensorFusionEngine) for rep detection",
        "4. User marks sets complete → progressionEngine records performance",
        "5. Muscle fatigue accumulated per exercise → muscle_fatigue table",
        "6. Rest timer between sets (RestTimerOverlay component)",
        "7. Next exercise → GetReadyOverlay → timer → repeat"
      ]
    },
    "workoutCompletion": {
      "sequence": [
        "1. All exercises completed or session ended",
        "2. Session analysis: total exercises, completion rate, duration",
        "3. XP calculation: 100 base + 20/exercise + streak bonus (xpService)",
        "4. Streak update: workout_streaks table",
        "5. Snapshot triggered (SnapshotService)",
        "6. dataSyncService broadcasts 'workout_completed' event",
        "7. ConfettiBurst animation + WorkoutSummaryView"
      ]
    },
    "dailyRecovery": {
      "sequence": [
        "1. recoveryEngine.dailyRecoveryTick()",
        "2. Each muscle: fatigue -= 8% per day (passive recovery)",
        "3. Sleep quality multiplier applied (SleepAnalysisEngine)",
        "4. BackgroundHealthEngine: 5min data collection cycle",
        "5. AnomalyDetector: 30min check cycle → encrypted alerts if anomaly found",
        "6. Daily summary written to daily_health_summaries table"
      ]
    },
    "aiConversation": {
      "sequence": [
        "1. User types message in Coach screen",
        "2. IntentRouter classifies intent → COACH/HEALTH/WORKOUT/etc.",
        "3. UserStateEngine aggregates user context (fatigue, streak, goals)",
        "4. DualAIEngine selects COACH personality",
        "5. Template-based response + optional API augmentation (Grok → Groq → OpenRouter)",
        "6. Conversation encrypted and stored in encrypted_ai_conversations",
        "7. AdaptiveMemoryEngine updates coaching memory"
      ]
    },
    "subscriptionCheck": {
      "sequence": [
        "1. SubscriptionManager checks RevenueCat entitlements",
        "2. Fallback to local trial_state table if offline",
        "3. State machine: LOADING → check tier → TRIAL (14 days) / FULL (premium) / LOCKED (expired)",
        "4. PremiumGate component reads SubscriptionContext",
        "5. Gated content shows paywall or premium features based on tier"
      ]
    }
  },
