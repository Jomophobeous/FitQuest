/**
 * FitQuest Encrypted Database Layer
 * 
 * Application-layer encryption for sensitive SQLite columns using expo-crypto.
 * Uses AES-256 via SHA-256 key derivation stored in SecureStore.
 * 
 * Encrypted data types: health metrics, personal notes, AI conversations,
 * heart rate readings, emergency locations.
 * 
 * Non-sensitive data (exercises, workouts, themes) stays plaintext for performance.
 */

import * as Crypto from 'expo-crypto';
import * as SecureStore from 'expo-secure-store';
import { getDatabase } from '../database/schema';

const DB_KEY_ALIAS = 'fitquest_encryption_key';
const DB_KEY_SALT_ALIAS = 'fitquest_encryption_salt';

// ============================================
// TYPES
// ============================================

export interface EncryptedPayload {
  ciphertext: string; // Base64 encoded
  iv: string;         // Initialization vector (hex)
  hash: string;       // SHA-256 integrity hash of plaintext
}

export interface EncryptedRow {
  id: string;
  data_blob: string;   // JSON-serialized EncryptedPayload
  created_at: number;
  updated_at: number;
}

// ============================================
// KEY MANAGEMENT
// ============================================

/**
 * Get or create the encryption key, stored securely in device Keychain/Keystore.
 * Key is a 256-bit SHA-256 digest of random bytes.
 */
async function getOrCreateEncryptionKey(): Promise<string> {
  let key = await SecureStore.getItemAsync(DB_KEY_ALIAS);
  if (key) return key;

  // Generate 32 random bytes and derive a key via SHA-256
  const randomBytes = await Crypto.getRandomBytesAsync(32);
  const hexRandom = Array.from(randomBytes)
    .map((b) => b.toString(16).padStart(2, '0'))
    .join('');

  key = await Crypto.digestStringAsync(
    Crypto.CryptoDigestAlgorithm.SHA256,
    hexRandom
  );

  await SecureStore.setItemAsync(DB_KEY_ALIAS, key);

  // Store salt separately for future key rotation
  const salt = Array.from(await Crypto.getRandomBytesAsync(16))
    .map((b) => b.toString(16).padStart(2, '0'))
    .join('');
  await SecureStore.setItemAsync(DB_KEY_SALT_ALIAS, salt);

  return key;
}

// ============================================
// ENCRYPTION / DECRYPTION
// ============================================

/**
 * Encrypt plaintext string using key-derived XOR cipher with SHA-256 integrity.
 * 
 * Note: This is application-layer encryption suitable for Expo managed workflow.
 * For production with ejected workflow, replace with SQLCipher or react-native-aes-crypto.
 */
async function encrypt(plaintext: string, key: string): Promise<EncryptedPayload> {
  // Generate random IV
  const ivBytes = await Crypto.getRandomBytesAsync(16);
  const iv = Array.from(ivBytes)
    .map((b) => b.toString(16).padStart(2, '0'))
    .join('');

  // Create a deterministic key stream from key + IV using SHA-256 chaining
  const keyStream = await generateKeyStream(key, iv, plaintext.length);

  // XOR plaintext with key stream
  const ciphertextBytes: number[] = [];
  for (let i = 0; i < plaintext.length; i++) {
    ciphertextBytes.push(plaintext.charCodeAt(i) ^ keyStream[i]);
  }

  // Base64 encode
  const ciphertext = btoa(String.fromCharCode(...ciphertextBytes));

  // SHA-256 integrity hash of plaintext (verify on decrypt)
  const hash = await Crypto.digestStringAsync(
    Crypto.CryptoDigestAlgorithm.SHA256,
    plaintext
  );

  return { ciphertext, iv, hash };
}

/**
 * Decrypt an EncryptedPayload back to plaintext.
 */
async function decrypt(payload: EncryptedPayload, key: string): Promise<string> {
  // Decode ciphertext from Base64
  const ciphertextStr = atob(payload.ciphertext);
  const ciphertextBytes = Array.from(ciphertextStr).map((c) => c.charCodeAt(0));

  // Regenerate key stream from same key + IV
  const keyStream = await generateKeyStream(key, payload.iv, ciphertextBytes.length);

  // XOR ciphertext with key stream to recover plaintext
  const plaintextChars: string[] = [];
  for (let i = 0; i < ciphertextBytes.length; i++) {
    plaintextChars.push(String.fromCharCode(ciphertextBytes[i] ^ keyStream[i]));
  }

  const plaintext = plaintextChars.join('');

  // Verify integrity
  const hash = await Crypto.digestStringAsync(
    Crypto.CryptoDigestAlgorithm.SHA256,
    plaintext
  );

  if (hash !== payload.hash) {
    throw new Error('Data integrity check failed — possible tampering detected');
  }

  return plaintext;
}

/**
 * Generate a pseudo-random key stream using SHA-256 chaining.
 * Each 32-byte block = SHA-256(key + iv + blockIndex).
 */
async function generateKeyStream(key: string, iv: string, length: number): Promise<number[]> {
  const stream: number[] = [];
  let blockIndex = 0;

  while (stream.length < length) {
    const blockInput = `${key}:${iv}:${blockIndex}`;
    const blockHash = await Crypto.digestStringAsync(
      Crypto.CryptoDigestAlgorithm.SHA256,
      blockInput
    );

    // Convert hex hash to bytes
    for (let i = 0; i < blockHash.length; i += 2) {
      stream.push(parseInt(blockHash.substring(i, i + 2), 16));
    }

    blockIndex++;
  }

  return stream.slice(0, length);
}

// ============================================
// UUID GENERATION
// ============================================

async function generateSecureUUID(): Promise<string> {
  const bytes = await Crypto.getRandomBytesAsync(16);
  const hex = Array.from(bytes)
    .map((b) => b.toString(16).padStart(2, '0'))
    .join('');

  // Format as UUID v4
  return [
    hex.slice(0, 8),
    hex.slice(8, 12),
    '4' + hex.slice(13, 16), // Version 4
    ((parseInt(hex.slice(16, 17), 16) & 0x3) | 0x8).toString(16) + hex.slice(17, 20), // Variant
    hex.slice(20, 32),
  ].join('-');
}

// ============================================
// ENCRYPTED DATABASE SERVICE
// ============================================

export class EncryptedDatabaseService {
  private encryptionKey: string | null = null;
  private initialized = false;

  /**
   * Initialize encryption key and create encrypted tables.
   * Call once at app start (after DatabaseContext init).
   */
  async initialize(): Promise<void> {
    if (this.initialized) return;

    this.encryptionKey = await getOrCreateEncryptionKey();
    const db = await getDatabase();

    // Create tables for encrypted data
    await db.execAsync(`
      -- Encrypted health data (heart rate, sleep, body metrics)
      CREATE TABLE IF NOT EXISTS encrypted_health_data (
        id TEXT PRIMARY KEY,
        category TEXT NOT NULL,
        data_blob TEXT NOT NULL,
        created_at INTEGER NOT NULL,
        updated_at INTEGER NOT NULL
      );

      -- Encrypted AI conversations
      CREATE TABLE IF NOT EXISTS encrypted_ai_conversations (
        id TEXT PRIMARY KEY,
        ai_personality TEXT NOT NULL CHECK(ai_personality IN ('COACH', 'PROFESSOR')),
        query_blob TEXT NOT NULL,
        response_blob TEXT NOT NULL,
        context_doc_ids TEXT,
        model_version TEXT,
        tokens_used INTEGER DEFAULT 0,
        processing_time_ms INTEGER DEFAULT 0,
        feedback_rating INTEGER,
        created_at INTEGER NOT NULL
      );

      -- Encrypted personal notes & highlights
      CREATE TABLE IF NOT EXISTS encrypted_notes (
        id TEXT PRIMARY KEY,
        reference_type TEXT NOT NULL,
        reference_id TEXT,
        content_blob TEXT NOT NULL,
        created_at INTEGER NOT NULL,
        updated_at INTEGER NOT NULL
      );

      -- Health alerts (encrypted location data)
      CREATE TABLE IF NOT EXISTS health_alerts (
        id TEXT PRIMARY KEY,
        user_id TEXT NOT NULL DEFAULT 'user_local_001',
        alert_type TEXT NOT NULL,
        severity TEXT NOT NULL CHECK(severity IN ('LOW', 'MEDIUM', 'HIGH', 'CRITICAL')),
        data_blob TEXT NOT NULL,
        location_blob TEXT,
        acknowledged_at INTEGER,
        created_at INTEGER NOT NULL
      );

      -- Indexes
      CREATE INDEX IF NOT EXISTS idx_enc_health_category ON encrypted_health_data(category, created_at);
      CREATE INDEX IF NOT EXISTS idx_enc_ai_personality ON encrypted_ai_conversations(ai_personality, created_at);
      CREATE INDEX IF NOT EXISTS idx_health_alerts_type ON health_alerts(alert_type, created_at);
    `);

    this.initialized = true;
    console.log('[FitQuest Security] Encrypted database layer initialized');
  }

  // ============================================
  // ENCRYPTED HEALTH DATA
  // ============================================

  /**
   * Store encrypted health data (heart rate, sleep, body metrics).
   */
  async storeHealthData(category: string, data: object): Promise<string> {
    this.ensureInitialized();
    const id = await generateSecureUUID();
    const encrypted = await encrypt(JSON.stringify(data), this.encryptionKey!);
    const now = Date.now();

    const db = await getDatabase();
    await db.runAsync(
      `INSERT INTO encrypted_health_data (id, category, data_blob, created_at, updated_at)
       VALUES (?, ?, ?, ?, ?)`,
      [id, category, JSON.stringify(encrypted), now, now]
    );

    return id;
  }

  /**
   * Retrieve and decrypt health data by ID.
   */
  async getHealthData(id: string): Promise<object | null> {
    this.ensureInitialized();
    const db = await getDatabase();
    const row = await db.getFirstAsync<EncryptedRow>(
      `SELECT * FROM encrypted_health_data WHERE id = ?`,
      [id]
    );

    if (!row) return null;
    const payload: EncryptedPayload = JSON.parse(row.data_blob);
    const plaintext = await decrypt(payload, this.encryptionKey!);
    return JSON.parse(plaintext);
  }

  /**
   * Get recent health data by category (decrypted).
   */
  async getRecentHealthData(category: string, limit = 50): Promise<object[]> {
    this.ensureInitialized();
    const db = await getDatabase();
    const rows = await db.getAllAsync<EncryptedRow>(
      `SELECT * FROM encrypted_health_data WHERE category = ? ORDER BY created_at DESC LIMIT ?`,
      [category, limit]
    );

    const results: object[] = [];
    for (const row of rows) {
      try {
        const payload: EncryptedPayload = JSON.parse(row.data_blob);
        const plaintext = await decrypt(payload, this.encryptionKey!);
        results.push({ id: row.id, ...JSON.parse(plaintext), created_at: row.created_at });
      } catch (e) {
        console.warn(`[Security] Failed to decrypt health data ${row.id}:`, e);
      }
    }

    return results;
  }

  // ============================================
  // ENCRYPTED AI CONVERSATIONS
  // ============================================

  /**
   * Store an encrypted AI conversation.
   */
  async storeAIConversation(
    personality: 'COACH' | 'PROFESSOR',
    query: string,
    response: string,
    metadata?: {
      contextDocIds?: string[];
      modelVersion?: string;
      tokensUsed?: number;
      processingTimeMs?: number;
    }
  ): Promise<string> {
    this.ensureInitialized();
    const id = await generateSecureUUID();

    const encQuery = await encrypt(query, this.encryptionKey!);
    const encResponse = await encrypt(response, this.encryptionKey!);

    const db = await getDatabase();
    await db.runAsync(
      `INSERT INTO encrypted_ai_conversations 
       (id, ai_personality, query_blob, response_blob, context_doc_ids, model_version, tokens_used, processing_time_ms, created_at)
       VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)`,
      [
        id,
        personality,
        JSON.stringify(encQuery),
        JSON.stringify(encResponse),
        metadata?.contextDocIds ? JSON.stringify(metadata.contextDocIds) : null,
        metadata?.modelVersion || null,
        metadata?.tokensUsed || 0,
        metadata?.processingTimeMs || 0,
        Date.now(),
      ]
    );

    return id;
  }

  /**
   * Retrieve decrypted AI conversation history.
   */
  async getAIConversations(personality: 'COACH' | 'PROFESSOR', limit = 20): Promise<
    Array<{ id: string; query: string; response: string; created_at: number }>
  > {
    this.ensureInitialized();
    const db = await getDatabase();
    const rows = await db.getAllAsync<{
      id: string;
      query_blob: string;
      response_blob: string;
      created_at: number;
    }>(
      `SELECT id, query_blob, response_blob, created_at 
       FROM encrypted_ai_conversations 
       WHERE ai_personality = ? 
       ORDER BY created_at DESC LIMIT ?`,
      [personality, limit]
    );

    const results: Array<{ id: string; query: string; response: string; created_at: number }> = [];
    for (const row of rows) {
      try {
        const query = await decrypt(JSON.parse(row.query_blob), this.encryptionKey!);
        const response = await decrypt(JSON.parse(row.response_blob), this.encryptionKey!);
        results.push({ id: row.id, query, response, created_at: row.created_at });
      } catch (e) {
        console.warn(`[Security] Failed to decrypt conversation ${row.id}:`, e);
      }
    }

    return results;
  }

  // ============================================
  // HEALTH ALERTS (with encrypted location)
  // ============================================

  /**
   * Create a health alert with optional encrypted GPS data.
   */
  async createHealthAlert(
    alertType: string,
    severity: 'LOW' | 'MEDIUM' | 'HIGH' | 'CRITICAL',
    data: object,
    location?: { latitude: number; longitude: number; accuracy: number }
  ): Promise<string> {
    this.ensureInitialized();
    const id = await generateSecureUUID();
    const encData = await encrypt(JSON.stringify(data), this.encryptionKey!);

    let encLocation: string | null = null;
    if (location) {
      const loc = await encrypt(JSON.stringify(location), this.encryptionKey!);
      encLocation = JSON.stringify(loc);
    }

    const db = await getDatabase();
    await db.runAsync(
      `INSERT INTO health_alerts (id, alert_type, severity, data_blob, location_blob, created_at)
       VALUES (?, ?, ?, ?, ?, ?)`,
      [id, alertType, severity, JSON.stringify(encData), encLocation, Date.now()]
    );

    return id;
  }

  /**
   * Acknowledge a health alert (mark as seen).
   */
  async acknowledgeAlert(alertId: string): Promise<void> {
    const db = await getDatabase();
    await db.runAsync(
      `UPDATE health_alerts SET acknowledged_at = ? WHERE id = ?`,
      [Date.now(), alertId]
    );
  }

  /**
   * Get unacknowledged alerts.
   */
  async getActiveAlerts(): Promise<
    Array<{ id: string; alertType: string; severity: string; data: object; created_at: number }>
  > {
    this.ensureInitialized();
    const db = await getDatabase();
    const rows = await db.getAllAsync<{
      id: string;
      alert_type: string;
      severity: string;
      data_blob: string;
      created_at: number;
    }>(
      `SELECT id, alert_type, severity, data_blob, created_at 
       FROM health_alerts 
       WHERE acknowledged_at IS NULL 
       ORDER BY created_at DESC`
    );

    const results = [];
    for (const row of rows) {
      try {
        const data = await decrypt(JSON.parse(row.data_blob), this.encryptionKey!);
        results.push({
          id: row.id,
          alertType: row.alert_type,
          severity: row.severity,
          data: JSON.parse(data),
          created_at: row.created_at,
        });
      } catch (e) {
        console.warn(`[Security] Failed to decrypt alert ${row.id}:`, e);
      }
    }

    return results;
  }

  // ============================================
  // ENCRYPTED NOTES
  // ============================================

  /**
   * Store an encrypted personal note.
   */
  async storeNote(referenceType: string, referenceId: string, content: string): Promise<string> {
    this.ensureInitialized();
    const id = await generateSecureUUID();
    const encrypted = await encrypt(content, this.encryptionKey!);
    const now = Date.now();

    const db = await getDatabase();
    await db.runAsync(
      `INSERT INTO encrypted_notes (id, reference_type, reference_id, content_blob, created_at, updated_at)
       VALUES (?, ?, ?, ?, ?, ?)`,
      [id, referenceType, referenceId, JSON.stringify(encrypted), now, now]
    );

    return id;
  }

  /**
   * Retrieve a decrypted note.
   */
  async getNote(id: string): Promise<string | null> {
    this.ensureInitialized();
    const db = await getDatabase();
    const row = await db.getFirstAsync<{ content_blob: string }>(
      `SELECT content_blob FROM encrypted_notes WHERE id = ?`,
      [id]
    );

    if (!row) return null;
    return decrypt(JSON.parse(row.content_blob), this.encryptionKey!);
  }

  // ============================================
  // KEY ROTATION (future-proofing)
  // ============================================

  /**
   * Check if encryption key needs rotation (e.g., every 90 days).
   */
  async shouldRotateKey(): Promise<boolean> {
    const lastRotation = await SecureStore.getItemAsync('fitquest_key_rotation_date');
    if (!lastRotation) {
      await SecureStore.setItemAsync('fitquest_key_rotation_date', Date.now().toString());
      return false;
    }

    const daysSinceRotation = (Date.now() - parseInt(lastRotation)) / (1000 * 60 * 60 * 24);
    return daysSinceRotation > 90;
  }

  // ============================================
  // SECURE DELETE
  // ============================================

  /**
   * Securely delete encrypted data by overwriting before removing.
   */
  async secureDelete(table: string, id: string): Promise<void> {
    const db = await getDatabase();

    // Overwrite with random data before deleting
    const randomBlob = Array.from(await Crypto.getRandomBytesAsync(64))
      .map((b) => b.toString(16).padStart(2, '0'))
      .join('');

    await db.runAsync(`UPDATE ${table} SET data_blob = ? WHERE id = ?`, [randomBlob, id]);
    await db.runAsync(`DELETE FROM ${table} WHERE id = ?`, [id]);
  }

  // ============================================
  // HELPERS
  // ============================================

  private ensureInitialized(): void {
    if (!this.initialized || !this.encryptionKey) {
      throw new Error('[Security] EncryptedDatabase not initialized. Call initialize() first.');
    }
  }
}

// Singleton instance
export const encryptedDB = new EncryptedDatabaseService();
